// rasterizador_multi.v
// Rasterizador de poligonos com 4 slots em paralelo.
//
// ALTERACOES (sincronismo):
//   Saida COMBINACIONAL (latencia 0) — sem registrador de saida.
//   Assim nao introduz atraso de endereco de pixel em relacao ao VGA.
//   O topo alimenta coordenadas logicas do pixel ATUAL (sem adiantamento).
//   cor_indice ja e RRRGGGBB (sem passagem por paleta).
//
// Regra de desempate: menor indice de slot vence.

module rasterizador_multi (
    input  wire clk_pix, reset,
    input  wire signed [9:0] logico_x, logico_y,

    input  wire signed [9:0] poly_vx [0:3][0:2],
    input  wire signed [9:0] poly_vy [0:3][0:2],
    input  wire [7:0]  poly_cor [0:3],
    input  wire poly_habilitado [0:3],
    input  wire poly_modo_retangulo [0:3],

    output wire pixel_ativo,
    output wire [7:0] cor_indice
);

    integer i;
    reg dentro [0:3];
    reg achou;
    reg [1:0] vencedor;

    function automatic dentro_triangulo;
        input signed [9:0] px, py, x0, y0, x1, y1, x2, y2;
        reg signed [23:0] e0, e1, e2;
        begin
            e0 = (px - x0) * (y1 - y0) - (py - y0) * (x1 - x0);
            e1 = (px - x1) * (y2 - y1) - (py - y1) * (x2 - x1);
            e2 = (px - x2) * (y0 - y2) - (py - y2) * (x0 - x2);
            dentro_triangulo = (e0 >= 0 && e1 >= 0 && e2 >= 0) ||
                                (e0 <= 0 && e1 <= 0 && e2 <= 0);
        end
    endfunction

    always @(*) begin
        for (i = 0; i < 4; i = i + 1) begin
            if (poly_modo_retangulo[i]) begin
                dentro[i] = poly_habilitado[i] &&
                            logico_x >= poly_vx[i][0] && logico_x < poly_vx[i][1] &&
                            logico_y >= poly_vy[i][0] && logico_y < poly_vy[i][1];
            end else begin
                dentro[i] = poly_habilitado[i] &&
                    dentro_triangulo(logico_x, logico_y,
                        poly_vx[i][0], poly_vy[i][0],
                        poly_vx[i][1], poly_vy[i][1],
                        poly_vx[i][2], poly_vy[i][2]);
            end
        end

        achou    = 1'b0;
        vencedor = 2'd0;
        for (i = 0; i < 4; i = i + 1) begin
            if (dentro[i] && !achou) begin
                achou    = 1'b1;
                vencedor = i[1:0];
            end
        end
    end

    assign pixel_ativo = achou;
    assign cor_indice  = poly_cor[vencedor]; // RRRGGGBB direto

endmodule
